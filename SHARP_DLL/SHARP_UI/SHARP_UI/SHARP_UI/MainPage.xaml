<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SHARP_UI.MainPage"
             Title="Student Management"
             BackgroundColor="#F8F9FA">
    
    <Grid Padding="20" RowSpacing="15" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        
        <Border Grid.Row="0" Grid.Column="0"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Shadow="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                               Path=BackgroundColor}">
            
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" 
                       BackgroundColor="#1565C0"
                       StrokeShape="RoundRectangle 12,12,0,0">
                    <Label Text="Список студентов"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Padding="15" />
                </Border>
                
                <CollectionView Grid.Row="1"
                               ItemsSource="{Binding StringList}"
                               SelectionMode="Single"
                               SelectedItem="{Binding SelectedString}"
                               Margin="0"
                               BackgroundColor="White">
                    
                    <CollectionView.Header>
                        <BoxView HeightRequest="1" 
                                Color="#EEEEEE" 
                                Margin="10,0"/>
                    </CollectionView.Header>
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="Transparent"
                                    StrokeThickness="0"
                                    Padding="15,12"
                                    BackgroundColor="Transparent">
                                
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- <Border Grid.Column="0" -->
                                    <!--        BackgroundColor="#E3F2FD" -->
                                    <!--        StrokeShape="RoundRectangle 20" -->
                                    <!--        HeightRequest="40" -->
                                    <!--        WidthRequest="40" -->
                                    <!--        VerticalOptions="Center"> -->
                                    <!--     <Label Text="👤" -->
                                    <!--            FontSize="18" -->
                                    <!--            VerticalOptions="Center" -->
                                    <!--            HorizontalOptions="Center" /> -->
                                    <!-- </Border> -->
                                    
                                    <VerticalStackLayout Grid.Column="1"
                                                        VerticalOptions="Center">
                                        <Label Text="{Binding}"
                                               FontSize="16"
                                               TextColor="#333333"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>
                                
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0,0,8,8" />
                                </Border.StrokeShape>
                                
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, 
                                                                  Path=SelectedItem}"
                                                 Value="{Binding}">
                                        <Setter Property="BackgroundColor" Value="#F0F7FF" />
                                        <Setter Property="Stroke" Value="#1565C0" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.Footer>
                        <Label Text="{Binding StringList.Count, StringFormat='Всего: {0}'}"
                               FontSize="14"
                               TextColor="#666666"
                               HorizontalOptions="Center"
                               Margin="0,15" />
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>
        </Border>
        
        
        <Border Grid.Row="0" Grid.Column="1"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Padding="25">
            
            <Grid RowSpacing="20" ColumnSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Редактировать"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1565C0"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />
                
                
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       BackgroundColor="#F5F5F5"
                       StrokeShape="RoundRectangle 8"
                       Stroke="Transparent"
                       Padding="15,10"
                       Margin="0,0,0,10">
                    
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="ExtendedInfoCheckBox"
                                  Color="#1565C0"
                                  VerticalOptions="Center"
                                  CheckedChanged="OnExtendedInfoChanged"/>
                        
                        <Label Text="староста"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                
                <!-- ID -->
                <Label Grid.Row="2" Grid.Column="0"
                       Text="ID:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center" />
                
                <Border Grid.Row="2" Grid.Column="1"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Entry x:Name="IdEntry"
                           Placeholder="ID"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center" />
                </Border>
                
                
                <Label Grid.Row="3" Grid.Column="0"
                       Text="Имя:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center" />
                
                <Border Grid.Row="3" Grid.Column="1"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Entry x:Name="NameEntry"
                           Placeholder="введите имя"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center" />
                </Border>
                
                <Label Grid.Row="4" Grid.Column="0"
                       Text="Фамилия:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center" />
                
                <Border Grid.Row="4" Grid.Column="1"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Entry x:Name="SurnameEntry"
                           Placeholder="введите фамилию"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center" />
                </Border>
                
                <Label Grid.Row="5" Grid.Column="0"
                       Text="возраст:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center" />
                
                <Border Grid.Row="5" Grid.Column="1"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Entry x:Name="AgeEntry"
                           Placeholder="введите возраст"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center"
                           Keyboard="Numeric" />
                </Border>
                
                <Label Grid.Row="6" Grid.Column="0"
                       x:Name="EmailLabel"
                       Text="Email:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center"
                       IsVisible="False" />
                
                <Border Grid.Row="6" Grid.Column="1"
                        x:Name="EmailBorder"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA"
                        IsVisible="False">
                    <Entry x:Name="EmailEntry"
                           Placeholder="введите email"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center"
                           Keyboard="Email" />
                </Border>
                
                <Label Grid.Row="7" Grid.Column="0"
                       x:Name="PhoneLabel"
                       Text="телефон:"
                       FontSize="16"
                       TextColor="#333333"
                       VerticalOptions="Center"
                       IsVisible="False" />
                
                <Border Grid.Row="7" Grid.Column="1"
                        x:Name="PhoneBorder"
                        Stroke="#E0E0E0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA"
                        IsVisible="False">
                    <Entry x:Name="PhoneEntry"
                           Placeholder="введите номер телефона"
                           FontSize="16"
                           TextColor="#333333"
                           BackgroundColor="Transparent"
                           HeightRequest="45"
                           Margin="10,0"
                           VerticalOptions="Center"
                           Keyboard="Telephone" />
                </Border>
            </Grid>
        </Border>
        
        <Border Grid.Row="1" Grid.Column="1"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Padding="15"
                Margin="0,15,0,0">
            
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="#4CAF50"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="загрузить"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnLoadClicked" />
                </Border>
                
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="#2196F3"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="сохранить"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnSaveClicked" />
                </Border>
                
                <Border Grid.Row="0" Grid.Column="2"
                        BackgroundColor="#9E9E9E"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="удалить всех"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnClearClicked" />
                </Border>
                
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="#FF9800"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="+студент"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnAddClicked" />
                </Border>
                
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="#3F51B5"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="+староста"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnChangeClicked" />
                </Border>
                
                <Border Grid.Row="1" Grid.Column="2"
                        BackgroundColor="#F44336"
                        StrokeShape="RoundRectangle 8"
                        HeightRequest="55">
                    <Button Text="удалить"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            Clicked="OnDeleteClicked" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>